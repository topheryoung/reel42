---
import Analytics from '@vercel/analytics/astro';
import '@fontsource/space-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const DEFAULT_DESCRIPTION =
  'Reel42 is an experimental, creative playground exploring the intersection of music and art.';
const DEFAULT_KEYWORDS =
  'mixtapes, curated playlists, album art, graphic design, vinyl, vinyl records';
const DEFAULT_OG_IMAGE = '/og-image.png';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  keywords = DEFAULT_KEYWORDS,
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;

const canonicalUrl = Astro.url.toString();
const absoluteOgImage = new URL(ogImage, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        var doc = document.documentElement;
        var theme = localStorage.getItem('theme');
        var darkOn =
          theme === null
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : theme === 'true';
        if (darkOn) doc.classList.add('dark');
        if (localStorage.getItem('mono') === 'true') doc.classList.add('mono');
        if (localStorage.getItem('retro-mode') === 'true')
          doc.classList.add('retro-mode');
      })();
    </script>

    <title>{title}</title>
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Christopher Young | hellotopher.com" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <Analytics />
    <script is:inline>
      document.querySelectorAll('img.cover, img.retro-cover').forEach((img) => {
        if (img.complete && img.naturalWidth > 0) img.classList.add('is-loaded');
        else
          img.addEventListener('load', () => img.classList.add('is-loaded'), {
            once: true,
          });
      });
    </script>
  </body>
</html>
