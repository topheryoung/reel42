---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { buildDisplayId } from '../../utils/displayId';
import { parseTracks } from '../../utils/parseTracks';

export async function getStaticPaths() {
  const mixtapes = await getCollection('mixtapes');
  const sorted = [...mixtapes].sort((a, b) => a.data.date - b.data.date);
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, entryIndex: i + 1 },
  }));
}

interface Props {
  entry: CollectionEntry<'mixtapes'>;
  entryIndex: number;
}

const { entry, entryIndex } = Astro.props;
const { title, cover, genre, href, date } = entry.data;
const displayId = buildDisplayId(date, title, entryIndex);
const year = 2000 + Math.floor(date / 100);

const tracks = parseTracks(entry.body ?? '');

const description = `${title} — a ${genre.join(', ')} mixtape (${tracks.length} tracks) curated by Christopher Young, with original album art.`;
const ogImage = new URL(
  cover.default.src,
  Astro.site ?? Astro.url
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicPlaylist',
  name: title,
  url: Astro.url.toString(),
  image: ogImage,
  genre,
  numTracks: tracks.length,
  track: tracks.map((t) => ({
    '@type': 'MusicRecording',
    name: t.title,
    ...(t.artist && {
      byArtist: { '@type': 'MusicGroup', name: t.artist },
    }),
  })),
};
---

<Layout
  title={`Reel42 | ${title}`}
  description={description}
  ogImage={ogImage}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <main class="detail">
    <nav class="breadcrumb">
      <a href="/" data-astro-prefetch>← Mixtapes</a>
      <span class="sep">/</span>
      <span class="current">{title}</span>
    </nav>

    <section class="hero">
      <div class="cover-frame">
        <Image src={cover.default} alt={title} class="cover" loading="eager" />
        <Image
          src={cover.retro}
          alt={title}
          class="retro-cover"
          loading="eager"
        />
      </div>
      <div class="meta">
        <div class="eyebrow">{displayId}</div>
        <h1 class="title">{title}</h1>
        <dl class="info">
          <dt>Year</dt><dd>{year}</dd>
          <dt>Genre</dt><dd>{genre.join(', ')}</dd>
        </dl>
        <section class:list={['tracklist']}>
          <div class="side">
            <div class="side-label">Tracklist</div>
            <ol>
              {
                tracks.map((t, i) => (
                  <li>
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="track">
                      <strong>{t.title}</strong>
                      {t.artist && <span class="artist"> — {t.artist}</span>}
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
        <div class="listen-label">Listen</div>
        <div class="listen">
          {
            href.apple && (
              <a
                href={href.apple}
                class="listen-btn"
                target="_blank"
                rel="noopener"
              >
                Apple Music
              </a>
            )
          }
          {
            href.spotify && (
              <a
                href={href.spotify}
                class="listen-btn"
                target="_blank"
                rel="noopener"
              >
                Spotify
              </a>
            )
          }
          {
            href.youtube && (
              <a
                href={href.youtube}
                class="listen-btn"
                target="_blank"
                rel="noopener"
              >
                YouTube
              </a>
            )
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .detail {
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 60px;
    border-bottom: 1px solid var(--card-accent);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secondary-text);
  }
  .breadcrumb a {
    color: var(--secondary-text);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--primary);
  }
  .breadcrumb .current {
    color: var(--header-text);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) 1fr;
    gap: 56px;
    padding: 56px 60px 40px;
    align-items: center;
  }
  .cover-frame {
    aspect-ratio: 1 / 1;
    background: var(--card-bg);
    outline: 1px solid var(--card-accent);
    overflow: hidden;
  }
  .cover-frame :global(.cover),
  .cover-frame :global(.retro-cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-frame :global(.retro-cover) {
    display: none;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--primary);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .title {
    font-family: var(--sans-serif);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--header-text);
    padding-bottom: 0.12em;
  }
  .info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 18px;
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--card-accent);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--primary-text);
  }
  .info dt {
    color: var(--secondary-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .info dd {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .listen {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .listen-btn {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 14px;
    border: 1px solid var(--card-accent);
    color: var(--primary-text);
    text-decoration: none;
  }
  .listen-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .tracklist {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
  }
  .tracklist.single {
    grid-template-columns: 1fr;
  }
  .side-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--secondary-text);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--card-accent);
  }
  .listen-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--secondary-text);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--card-accent);
  }
  .side ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .side li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    align-items: baseline;
  }
  .num {
    font-family: var(--mono);
    color: var(--secondary-text);
    font-size: 10px;
  }
  .track {
    font-family: var(--sans-serif);
    font-size: 14px;
    color: var(--primary-text);
  }
  .track strong {
    font-weight: 500;
    color: var(--header-text);
  }
  .artist {
    color: var(--secondary-text);
  }

  @media (max-width: 811px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 24px 32px;
    }
    .tracklist {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 24px;
    }
    .breadcrumb {
      padding: 16px 24px;
    }
  }
  @media (max-width: 480px) {
    .hero {
      padding: 32px 12px 24px;
    }
    .meta,
    .info,
    .listen {
      padding-right: 12px;
      padding-left: 12px;
    }
    .listen-label {
      margin-right: 12px;
      margin-left: 12px;
    }
    .listen {
      display: flex;
      flex-direction: column;
    }
    .tracklist {
      padding: 24px 12px;
    }
    .breadcrumb {
      padding: 16px 12px;
    }
  }
</style>
