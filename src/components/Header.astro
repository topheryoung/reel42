---
import Logo from './Logo.astro';
import Dark from '../components/modes/Dark.astro';
import Mono from '../components/modes/Mono.astro';
import Retro from './modes/Retro.astro';

const isAboutPage = Astro.url.pathname === '/about';
---

<header>
  <div class="logo">
    <Logo />
  </div>
  <nav>
    <a href="/" class={!isAboutPage ? 'active' : ''} data-astro-prefetch>
      Mixtapes
    </a>
    <a href="/about" class={isAboutPage ? 'active' : ''} data-astro-prefetch>
      About
    </a>
  </nav>
  <div class="controls">
    <Dark />
    <Mono />
    <Retro />
  </div>
</header>
<style>
  header {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--card-accent);
    background-color: var(--bg);
    padding: 16px 32px;
  }
  header > nav,
  header > div {
    width: 100%;
  }
  .controls {
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: repeat(auto-fit, min-content);
    gap: 12px;
    justify-content: end;
    width: max-content;
  }
  nav {
    display: grid;
    gap: 24px;
    letter-spacing: 1.1px;
    grid-auto-flow: column;
    grid-row: 1;
    grid-column: 2;
    place-content: center;
  }
  nav a {
    position: relative;
    text-decoration: none;
    color: var(--secondary-text);
    font-size: 12px;
    font-family: var(--mono);
    text-transform: uppercase;
    padding: 2px 0;
    transition: color 0.15s ease;
    &:hover {
      color: var(--primary-text);
    }
    &.active {
      color: var(--primary-text);
    }
    &::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--primary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }
    &.active::after {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    header {
      padding: 24px 24px;
    }
    .controls {
      display: none;
    }
    nav {
      grid-column: 3;
    }
  }

  @media (max-width: 480px) {
    header {
      padding: 24px 12px;
    }
  }
</style>
<style is:global>
  .control-btn {
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--secondary-text);
    color: var(--primary-text);
    padding: 5px 9px;
    margin: 0;
    font-size: 10px;
    font-family: var(--mono);
    font-weight: 600;
    text-transform: uppercase;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
    &:hover {
      border-color: var(--primary);
      color: var(--primary);
    }
  }
  .control-btn.is-active {
    color: var(--bg);
    background-color: var(--primary);
    border-color: var(--primary);
  }
</style>
