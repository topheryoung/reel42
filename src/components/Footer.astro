---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="copyright">
    <p>&copy;</p>
    <p style="color: var(--primary-text)">{currentYear}</p>
  </div>
  <div class="end-of-reel">
    <button
      class="control-btn"
      onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
    >
      Rewind Reel
    </button>
  </div>
  <div class="colophon">
    <p>Designed and Developed in BCN</p>
    <a style="color: var(--primary-text)" href="mailto:info@reel42.com"
      >info@reel42.com</a
    >
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--card-accent);
    padding: 12px 0 36px;
    margin: 0 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
  }
  .end-of-reel {
    display: grid;
    grid-auto-flow: column;
    grid-row: 1;
    grid-column: 2;
    place-content: center;
  }
  .colophon {
    display: flex;
    flex-direction: column;
    align-items: end;
  }
  p {
    color: var(--secondary-text);
    margin: 0;
    font-size: 13px;
  }
  a {
    text-decoration: none;
    color: var(--primary-text);
    font-size: 12px;
  }
</style>
