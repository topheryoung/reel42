---
const currentYear = new Date().getFullYear();
const isIndex = Astro.url.pathname === '/';
---

<footer>
  <div class="copyright">
    <p>&copy;</p>
    <p style="color: var(--primary-text)">{currentYear}</p>
  </div>
  {
    isIndex && (
      <div class="end-of-reel">
        <button class="control-btn" id="rewindReel">Rewind Reel</button>
      </div>
    )
  }
  <div class="colophon">
    <p>Designed and Developed in BCN</p>
    <a href="mailto:info@reel42.com">info@reel42.com</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--card-accent);
    padding: 12px 0 36px;
    margin: 0 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
  }
  .copyright {
    grid-column: 1;
  }
  .end-of-reel {
    display: grid;
    grid-auto-flow: column;
    grid-row: 1;
    grid-column: 2;
    place-content: center;
  }
  .colophon {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    align-items: end;
  }
  p {
    color: var(--secondary-text);
    margin: 0;
    font-size: 13px;
  }
  a {
    text-decoration: none;
    color: var(--primary-text);
    font-size: 12px;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--primary);
  }

  @media (max-width: 480px) {
    footer {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      row-gap: 24px;
    }
    .end-of-reel {
      grid-column: 1 / -1;
      grid-row: 1;
      display: block;
    }
    .end-of-reel .control-btn {
      width: 100%;
    }
    .copyright {
      grid-column: 1;
      grid-row: 2;
    }
    .colophon {
      grid-column: 2;
      grid-row: 2;
      text-align: right;
    }
  }
</style>

<script>
  // Delegated so the handler survives view-transition DOM swaps.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('#rewindReel')) return;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>
