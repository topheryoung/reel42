---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  id: string;
  genre: string[];
  cover: {
    default: ImageMetadata;
    retro: ImageMetadata;
  };
  alt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  title,
  id,
  genre,
  cover,
  alt,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

const formatGenres = (genres: string[]): string => genres[0];
---

<div class="card-item">
  <a href={`/mixtape/${id}`} data-astro-prefetch>
    <div class="cover-frame" transition:name={`cover-${id}`}>
      <Image
        src={cover.default}
        alt={alt}
        class="cover"
        widths={[240, 360, 540, 720, 900]}
        sizes="(max-width: 480px) 100vw, (max-width: 811px) 50vw, 33vw"
        quality={75}
        loading={loading}
        decoding="async"
        {...fetchpriority && { fetchpriority }}
      />
      <Image
        src={cover.retro}
        alt={alt}
        class="retro-cover"
        widths={[240, 360, 540, 720, 900]}
        sizes="(max-width: 480px) 100vw, (max-width: 811px) 50vw, 33vw"
        quality={75}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-details">
      <h2 class="card-title">
        {title}
      </h2>
      <h3>{formatGenres(genre)}</h3>
    </div>
  </a>
</div>

<style>
  a {
    text-decoration: none;
    color: transparent;
  }
  .cover-frame {
    position: relative;
    background: linear-gradient(
      100deg,
      var(--card-bg) 30%,
      var(--card-accent) 50%,
      var(--card-bg) 70%
    );
    background-size: 200% 100%;
    animation: cover-shimmer 1.6s ease-in-out infinite;
    display: flex;
    aspect-ratio: 1;
    overflow: hidden;
    outline: 1px solid transparent;
    transition: outline-color 0.15s ease;
  }
  a:hover .cover-frame,
  a:focus-visible .cover-frame {
    outline-color: var(--primary);
  }
  a:hover .cover,
  a:hover .retro-cover,
  a:focus-visible .cover,
  a:focus-visible .retro-cover {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .cover-frame {
      animation: none;
    }
    a:hover .cover,
    a:hover .retro-cover,
    a:focus-visible .cover,
    a:focus-visible .retro-cover {
      transform: none;
    }
  }
  .card-title {
    color: var(--primary-text);
    font-size: 18px;
    margin-top: 6px;
    margin-bottom: 0;
    line-height: 22px;
    transition: color 0.15s ease;
  }
  a:hover .card-title,
  a:focus-visible .card-title {
    color: var(--primary);
  }
  .card-details {
    color: var(--secondary-text);
    display: flex;
    color: var(--secondary-text);
    justify-content: space-between;
    align-items: flex-end;
    margin: 0 auto 12px;
  }
  .card-details h3 {
    margin: 0;
    font-weight: 400;
    font-size: 13px;
  }
  .cover,
  .retro-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    color: transparent;
  }
  .retro-cover {
    display: none;
  }

  @media (max-width: 480px) {
    .card-details > h3 {
      text-align: right;
    }
  }
</style>
