---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  id: string;
  displayID: string;
  href: { apple?: string; youtube?: string; spotify?: string };
  genre: string[];
  cover: {
    default: ImageMetadata;
    retro: ImageMetadata;
  };
  alt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  title,
  id,
  displayID,
  genre,
  cover,
  alt,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

const formatGenres = (genres: string[]): string => genres[0];
---

<div class="card-item">
  <a href={`/mixtape/${id}`} data-astro-prefetch>
    <div class="cover-frame">
      <!-- <h3 class="card-id">{displayID}</h3> -->
      <Image
        src={cover.default}
        alt={alt}
        class="cover"
        widths={[240, 360, 540, 720, 900]}
        sizes="(max-width: 480px) 100vw, (max-width: 811px) 50vw, 33vw"
        quality={75}
        loading={loading}
        decoding="async"
        {...fetchpriority && { fetchpriority }}
      />
      <Image
        src={cover.retro}
        alt={alt}
        class="retro-cover"
        widths={[240, 360, 540, 720, 900]}
        sizes="(max-width: 480px) 100vw, (max-width: 811px) 50vw, 33vw"
        quality={75}
        loading={loading}
        decoding="async"
      />
    </div>
    <div class="card-details">
      <h2 class="card-title">
        {title}
      </h2>
      <h3>{formatGenres(genre)}</h3>
    </div>
  </a>
</div>

<style>
  a {
    text-decoration: none;
    color: transparent;
  }
  .cover-frame {
    position: relative;
    background: var(--secondary-text);
    display: flex;
    aspect-ratio: 1;
    /* &:hover {
      outline: 1px solid var(--bg);
      outline-offset: -12px;
      .card-id {
        display: block;
      }
    } */
  }
  .card-title {
    color: var(--primary-text);
    font-size: 18px;
    margin-top: 6px;
    margin-bottom: 0;
    line-height: 22px;
  }
  .card-details {
    color: var(--secondary-text);
    display: flex;
    color: var(--secondary-text);
    justify-content: space-between;
    align-items: flex-end;
    margin: 0 auto 12px;
  }
  .card-details h3 {
    margin: 0;
    font-weight: 400;
    font-size: 13px;
  }
  .card-id {
    display: none;
    position: absolute;
    top: 10px;
    left: 16px;
    color: var(--primary-text);
    text-shadow: 0px 0px 2px var(--bg);
    font-family: var(--mono);
    font-size: 12px;
  }
  .cover,
  .retro-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    color: transparent;
  }
  .retro-cover {
    display: none;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .card-details {
      flex-direction: column-reverse;
    }
  }
</style>
