<button class="control-btn dark-mode-button" id="themeToggle">
  dark <span class="keyboard-shortcut">(d)</span>
</button>

<script>
  import { initModeToggle } from '../../utils/modeToggle';

  initModeToggle({
    buttonId: 'themeToggle',
    className: 'dark',
    storageKey: 'theme',
    hotkey: 'd',
    defaultOn: () => window.matchMedia('(prefers-color-scheme: dark)').matches,
  });
</script>
