<button class="control-btn" id="darkToggle">dark (d)</button>

<script>
  import { initModeToggle } from '../../utils/modeToggle';

  initModeToggle({
    buttonId: 'darkToggle',
    className: 'dark',
    storageKey: 'dark',
    hotkey: 'd',
    defaultOn: () => window.matchMedia('(prefers-color-scheme: dark)').matches,
  });
</script>
